{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mragerlp/VASCOUT/blob/main/schemas/relationships.schema.json",
  "title": "VASCOUT relationships",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
