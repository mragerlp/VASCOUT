{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mragerlp/VASCOUT/blob/main/schemas/requirements.schema.json",
  "title": "VASCOUT requirements",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "content_snapshot_date",
      "exported_at",
      "id",
      "item",
      "meaning",
      "measured_performance",
      "origin_app_id",
      "origin_revision",
      "origin_url",
      "record_id",
      "record_kind",
      "target",
      "verify"
    ],
    "properties": {
      "record_id": {
        "type": "string"
      },
      "id": {
        "type": "string"
      },
      "item": {
        "type": "string"
      },
      "target": {
        "type": "string"
      },
      "meaning": {
        "type": "string"
      },
      "verify": {
        "type": "string"
      },
      "record_kind": {
        "type": "string"
      },
      "measured_performance": {
        "type": "boolean"
      },
      "origin_app_id": {
        "type": "string"
      },
      "origin_revision": {
        "type": "integer"
      },
      "origin_url": {
        "type": "string"
      },
      "content_snapshot_date": {
        "type": "string"
      },
      "exported_at": {
        "type": "string"
      }
    }
  }
}
